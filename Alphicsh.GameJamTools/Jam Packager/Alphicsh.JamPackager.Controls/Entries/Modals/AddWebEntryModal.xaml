<Window
  x:Class="Alphicsh.JamPackager.Controls.Entries.Modals.AddWebEntryModal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:Alphicsh.JamPackager.Controls.Entries.Modals"
  xmlns:modals="clr-namespace:Alphicsh.JamTools.Common.Controls.Modals;assembly=Alphicsh.JamTools.Common.Controls"
  xmlns:cc="clr-namespace:Alphicsh.JamTools.Common.Controls;assembly=Alphicsh.JamTools.Common.Controls"
  mc:Ignorable="d"
  Style="{StaticResource ModalWindow}"
  Height="450" Width="800"
>
  <DockPanel>
    <modals:ModalHeader DockPanel.Dock="Top"/>

    <Border DockPanel.Dock="Bottom" Style="{StaticResource ModalToolbar}">
      <cc:ImpButton Style="{StaticResource PrimaryButton}" Margin="2" Width="96" Command="{Binding AddCommand}">Add entry</cc:ImpButton>
    </Border>

    <Border Style="{StaticResource ModalBody}">
      <Grid Background="{StaticResource MainBackgroundBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0">Title:</Label>
        <cc:ImpTextBox Grid.Row="0" Grid.Column="1" Margin="2" Text="{Binding Title}" Placeholder="&lt;enter title here&gt;"/>

        <Label Grid.Row="1" Grid.Column="0">Short title:</Label>
        <cc:ImpTextBox Grid.Row="1" Grid.Column="1" Margin="2" Text="{Binding ShortTitle}" Placeholder="&lt;same as main title&gt;"/>

        <Label Grid.Row="2" Grid.Column="0">Team:</Label>
        <cc:ImpTextBox Grid.Row="2" Grid.Column="1" Margin="2" Text="{Binding Team}" Placeholder="&lt;enter title here&gt;"/>

        <Label Grid.Row="3" Grid.Column="0">Authors:</Label>
        <cc:ImpTextBox Grid.Row="3" Grid.Column="1" Margin="2" Text="{Binding Authors}" Placeholder="&lt;same as main title&gt;"/>

        <Label Grid.Row="4" Grid.Column="0">Entry URL:</Label>
        <DockPanel Grid.Row="4" Grid.Column="1" Margin="2">
          <cc:ImpButton DockPanel.Dock="Right" Style="{DynamicResource HelpButton}" Width="64" BarPosition="End" Command="{Binding OpenUrlCommand}">Open</cc:ImpButton>
          <cc:ImpTextBox BarPosition="Start" Text="{Binding Url}" Placeholder="&lt;no entry URL given&gt;"/>
        </DockPanel>

      </Grid>
    </Border>
  </DockPanel>
</Window>
