<UserControl
  x:Class="Alphicsh.JamPackager.Controls.Entries.JamEntriesTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Alphicsh.JamPackager.Controls.Entries"
  xmlns:cc="clr-namespace:Alphicsh.JamTools.Common.Controls;assembly=Alphicsh.JamTools.Common.Controls"
  mc:Ignorable="d" 
  d:DesignHeight="450" d:DesignWidth="800"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="1*"/>
    </Grid.RowDefinitions>

    <GroupBox Grid.Row="0" Style="{StaticResource SimpleSection}">
      <WrapPanel HorizontalAlignment="Center">
        <cc:ImpButton Style="{StaticResource PrimaryButton}" Margin="2" Width="96" Command="{Binding AddTestEntryCommand}">Add page</cc:ImpButton>
      </WrapPanel>
    </GroupBox>
    
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="300"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="1*" MinWidth="400"/>
      </Grid.ColumnDefinitions>
    
      <!-- Entries list -->
      <local:JamEntriesList Grid.Column="0"/>

      <!-- Grid resizing splitter -->
      <GridSplitter
        Grid.Column="1"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Center"
        Width="8"
        Background="Transparent"
        ShowsPreview="True"
      />

      <local:JamEntryEditor Grid.Column="2"/>
    </Grid>
  </Grid>
</UserControl>
