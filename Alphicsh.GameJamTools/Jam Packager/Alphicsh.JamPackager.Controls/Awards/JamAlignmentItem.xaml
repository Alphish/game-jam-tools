<UserControl
  x:Class="Alphicsh.JamPackager.Controls.Awards.JamAlignmentItem"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  xmlns:local="clr-namespace:Alphicsh.JamPackager.Controls.Awards"
  xmlns:cc="clr-namespace:Alphicsh.JamTools.Common.Controls;assembly=Alphicsh.JamTools.Common.Controls"
  mc:Ignorable="d" 
  d:DesignWidth="800"
>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" SharedSizeGroup="AddRemove"/>
      <ColumnDefinition Width="2*" MinWidth="60"/>
      <ColumnDefinition Width="3*" MinWidth="80"/>
      <ColumnDefinition Width="3*" MinWidth="80"/>
      <ColumnDefinition Width="3*" MinWidth="80"/>
      <ColumnDefinition Width="2*" MinWidth="60"/>
    </Grid.ColumnDefinitions>

    <cc:ImpButton
      Grid.Column="0"
      Style="{StaticResource DangerButton}"
      Margin="2"
      Width="40"
      Command="{Binding DataContext.AlignmentsDefinition.Alignments.RemoveAlignmentCommand, RelativeSource={RelativeSource AncestorType=local:JamAwardsTab}}"
      CommandParameter="{Binding}"
    >x</cc:ImpButton>

    <cc:ImpTextBox Grid.Column="1" Margin="2" Text="{Binding Id}"/>
    <cc:ImpTextBox Grid.Column="2" Margin="2" Text="{Binding Title}" Foreground="{Binding Brush, TargetNullValue={StaticResource BasicText}}"/>
    <cc:ImpTextBox Grid.Column="3" Margin="2" Text="{Binding ShortTitle}" Foreground="{Binding Brush, TargetNullValue={StaticResource BasicText}}"/>
    <cc:ImpTextBox Grid.Column="4" Margin="2" Text="{Binding KeywordsString}"/>
    <cc:ImpTextBox Grid.Column="5" Margin="2" Text="{Binding ColorString}"/>
  </Grid>
</UserControl>
