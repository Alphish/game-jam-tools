<UserControl
  x:Class="Alphicsh.JamPackager.Controls.Awards.JamAlignmentsHeader"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  xmlns:local="clr-namespace:Alphicsh.JamPackager.Controls.Awards"
  xmlns:cc="clr-namespace:Alphicsh.JamTools.Common.Controls;assembly=Alphicsh.JamTools.Common.Controls"
  mc:Ignorable="d" 
  d:DesignWidth="800"
>
  <Grid HorizontalAlignment="Stretch">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" SharedSizeGroup="AddRemove"/>
      <ColumnDefinition Width="2*" MinWidth="60"/>
      <ColumnDefinition Width="3*" MinWidth="80"/>
      <ColumnDefinition Width="3*" MinWidth="80"/>
      <ColumnDefinition Width="3*" MinWidth="80"/>
      <ColumnDefinition Width="2*" MinWidth="60"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition/>
    </Grid.RowDefinitions>

    <!-- Neither title -->
    <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource ItemLabel}" HorizontalAlignment="Right">No alignment:</Label>
    <cc:ImpTextBox Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="0" Margin="2" Text="{Binding NeitherTitle}"/>
    
    <!-- Table headers -->
    <cc:ImpButton
      Grid.Column="0"
      Grid.Row="1"
      Style="{StaticResource PrimaryButton}"
      Margin="2"
      Width="40"
      Command="{Binding Alignments.AddAlignmentCommand}"
    >+</cc:ImpButton>

    <Label Grid.Column="1" Grid.Row="1" Style="{StaticResource TableLabel}">ID</Label>
    <Label Grid.Column="2" Grid.Row="1" Style="{StaticResource TableLabel}">Title</Label>
    <Label Grid.Column="3" Grid.Row="1" Style="{StaticResource TableLabel}">Short title</Label>
    <Label Grid.Column="4" Grid.Row="1" Style="{StaticResource TableLabel}">Keywords</Label>
    <Label Grid.Column="5" Grid.Row="1" Style="{StaticResource TableLabel}">Color</Label>
  </Grid>
</UserControl>
