<UserControl
  x:Class="Alphicsh.EntryPackager.Controls.BasicInfo.EntryBasicInfoTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  xmlns:local="clr-namespace:Alphicsh.EntryPackager.Controls.BasicInfo"
  xmlns:cc="clr-namespace:Alphicsh.JamTools.Common.Controls;assembly=Alphicsh.JamTools.Common.Controls"
  mc:Ignorable="d" 
  d:DesignHeight="600" d:DesignWidth="800"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="1*"/>
    </Grid.RowDefinitions>
    <GroupBox Grid.Row="0" Header="Entry summary">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0">Title:</Label>
        <cc:ImpTextBox Grid.Row="0" Grid.Column="1" Margin="2" Text="{Binding Title}" Placeholder="&lt;enter title here&gt;"/>

        <Label Grid.Row="1" Grid.Column="0">Short title:</Label>
        <cc:ImpTextBox Grid.Row="1" Grid.Column="1" Margin="2" Text="{Binding ShortTitle}" Placeholder="&lt;same as main title&gt;"/>

        <Label Grid.Row="2" Grid.Column="0">Page:</Label>
        <DockPanel Grid.Row="2" Grid.Column="1" Margin="2">
          <cc:ImpButton DockPanel.Dock="Right" Style="{DynamicResource HelpButton}" Width="64" BarPosition="End" Command="{Binding OpenPageCommand}">Open</cc:ImpButton>
          <cc:ImpTextBox BarPosition="Start" Text="{Binding PageUrl}" Placeholder="&lt;no page URL given&gt;"/>
        </DockPanel>

        <Label Grid.Row="3" Grid.Column="0">Alignment:</Label>
        <cc:ImpTextBox Grid.Row="3" Grid.Column="1" Margin="2" Text="{Binding Alignment}" Placeholder="&lt;no alignment given&gt;"/>
      </Grid>
    </GroupBox>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Column="0" Header="Team">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>


          <Label Grid.Row="0" Grid.Column="0">Team name:</Label>
          <cc:ImpTextBox Grid.Row="0" Grid.Column="1" Margin="2" Text="{Binding Team.Name}" Placeholder="&lt;same as authors&gt;"/>

          <Label Grid.Row="1" Grid.Column="0">Authors:</Label>
          <cc:ImpTextBox Grid.Row="1" Grid.Column="1" Margin="2" Text="{Binding Team.AuthorsString}" Placeholder="&lt;enter authors here&gt;"/>

          <local:EntryAuthorsList Grid.Row="2" Grid.Column="1" DataContext="{Binding Team}"/>
        </Grid>
      </GroupBox>

      <GroupBox Grid.Column="2" Header="Attribution" DataContext="{Binding Attribution}">
        <StackPanel HorizontalAlignment="Stretch">
          <Label HorizontalAlignment="Center" Margin="0">Code:</Label>
          <ComboBox
            Width="160" Margin="2"
            SelectedValue="{Binding Code}" ItemsSource="{Binding AvailableAttributionTypes}" SelectedValuePath="Value"
          >
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="Segoe UI" FontSize="13" Text="{Binding Description}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Label HorizontalAlignment="Center" Margin="0">Visuals:</Label>
          <ComboBox
            Width="160" Margin="2"
            SelectedValue="{Binding Visuals}" ItemsSource="{Binding AvailableAttributionTypes}" SelectedValuePath="Value"
          >
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="Segoe UI" FontSize="13" Text="{Binding Description}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Label HorizontalAlignment="Center" Margin="0">Music:</Label>
          <ComboBox
            Width="160" Margin="2"
            SelectedValue="{Binding Music}" ItemsSource="{Binding AvailableAttributionTypes}" SelectedValuePath="Value"
          >
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="Segoe UI" FontSize="13" Text="{Binding Description}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Label HorizontalAlignment="Center" Margin="0">Sounds:</Label>
          <ComboBox
            Width="160" Margin="2"
            SelectedValue="{Binding Sounds}" ItemsSource="{Binding AvailableAttributionTypes}" SelectedValuePath="Value"
          >
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="Segoe UI" FontSize="13" Text="{Binding Description}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Separator/>
          <cc:ImpButton Style="{StaticResource HelpButton}" Width="64" Margin="2" Command="{Binding OpenGuideCommand}">Help</cc:ImpButton>
        </StackPanel>
      </GroupBox>
    </Grid>
  </Grid>
</UserControl>
